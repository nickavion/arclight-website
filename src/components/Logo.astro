---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';

// Wordmark plus a mark: the EV Street Co pineapple, using the same artwork as
// the site favicon (src/assets/favicons/favicon.png), paired with the name.
import logoMark from '~/assets/favicons/favicon.png';
---

<span class="flex items-center gap-2.5 self-center whitespace-nowrap">
  <Image src={logoMark} alt={`${SITE?.name} logo`} width={64} height={64} class="h-8 w-8 shrink-0" loading="eager" />
  <span class="font-heading text-2xl font-bold tracking-tight text-heading md:text-xl">{SITE?.name}</span>
</span>
