---
import { SITE } from 'astrowind:config';

// Wordmark plus a mark: a J1772 handle silhouette in harbor blue with the arc
// struck through it in amber. The amber is the "arc" in Arclight and is used
// here as a shape, never as text.
---

<span class="flex items-center gap-2.5 self-center whitespace-nowrap">
  <svg
    viewBox="0 0 32 32"
    class="h-8 w-8 shrink-0"
    role="img"
    aria-label={`${SITE?.name} mark`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="32" height="32" rx="8" fill="var(--aw-color-primary)"></rect>
    <path
      d="M16 5.5c-4.6 0-8.3 3.6-8.3 8.1v4.6c0 3.4 2.2 6.3 5.4 7.4v1.9h5.8v-1.9c3.2-1.1 5.4-4 5.4-7.4v-4.6c0-4.5-3.7-8.1-8.3-8.1Z"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="1.9"
      stroke-linejoin="round"
      opacity="0.92"></path>
    <path d="M17.9 10.2 12.6 17h3.2l-1.7 5.1 5.3-6.8h-3.2l1.7-5.1Z" fill="var(--aw-color-accent)"></path>
  </svg>
  <span class="font-heading text-2xl font-bold tracking-tight text-heading md:text-xl">{SITE?.name}</span>
</span>
