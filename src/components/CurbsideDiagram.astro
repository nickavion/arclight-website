---
/**
 * Side elevation of a curbside install: panel inside the building, buried
 * conduit under the sidewalk, station at the curb, car in the space.
 *
 * Deliberately schematic. The template's rule is that no image may show
 * hardware EV Street Co does not actually ship — a photoreal render of a charger
 * that does not exist is a promise that breaks on install day. A labelled
 * diagram sells the same thing (what you get, where it goes) and asserts
 * nothing about the enclosure.
 *
 * Colours come from the brand tokens so it tracks light and dark automatically.
 */
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={className}>
  <svg
    viewBox="0 0 820 470"
    class="w-full h-auto"
    role="img"
    aria-labelledby="curbside-diagram-title curbside-diagram-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="curbside-diagram-title">How a curbside install fits together</title>
    <desc id="curbside-diagram-desc">
      A side view of a building at the left with its electrical panel, a buried conduit run beneath the sidewalk, a
      Level 2 charging station standing at the curb, and an electric car parked in the space with its cable connected.
    </desc>

    <defs>
      <pattern id="trench-hatch" width="9" height="9" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="9" stroke="var(--aw-color-primary)" stroke-width="1.1" opacity="0.25"></line>
      </pattern>
      <linearGradient id="sky-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--aw-color-primary)" stop-opacity="0.09"></stop>
        <stop offset="100%" stop-color="var(--aw-color-primary)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="820" height="352" fill="url(#sky-fade)" rx="12"></rect>

    <!-- ground / sub-grade -->
    <rect x="0" y="352" width="820" height="118" fill="var(--aw-color-primary)" opacity="0.06"></rect>
    <line x1="0" y1="352" x2="820" y2="352" stroke="var(--aw-color-primary)" stroke-width="2" opacity="0.35"></line>

    <!-- building -->
    <g>
      <rect x="34" y="86" width="196" height="266" rx="4" fill="var(--aw-color-primary)" opacity="0.12"></rect>
      <rect
        x="34"
        y="86"
        width="196"
        height="266"
        rx="4"
        fill="none"
        stroke="var(--aw-color-primary)"
        stroke-width="2.2"
        opacity="0.6"></rect>
      <path d="M24 86 132 40 240 86Z" fill="var(--aw-color-primary)" opacity="0.22"></path>
      <path
        d="M24 86 132 40 240 86"
        fill="none"
        stroke="var(--aw-color-primary)"
        stroke-width="2.2"
        stroke-linejoin="round"
        opacity="0.6"></path>
      <g fill="var(--aw-color-primary)" opacity="0.22">
        <rect x="58" y="116" width="38" height="46" rx="3"></rect>
        <rect x="112" y="116" width="38" height="46" rx="3"></rect>
        <rect x="166" y="116" width="38" height="46" rx="3"></rect>
        <rect x="58" y="188" width="38" height="46" rx="3"></rect>
        <rect x="112" y="188" width="38" height="46" rx="3"></rect>
      </g>
      <rect x="166" y="270" width="42" height="82" rx="3" fill="var(--aw-color-primary)" opacity="0.3"></rect>

      <!-- panel -->
      <rect x="170" y="192" width="34" height="46" rx="3" fill="var(--aw-color-bg-page)"></rect>
      <rect
        x="170"
        y="192"
        width="34"
        height="46"
        rx="3"
        fill="none"
        stroke="var(--aw-color-primary)"
        stroke-width="2.2"></rect>
      <line x1="176" y1="204" x2="198" y2="204" stroke="var(--aw-color-primary)" stroke-width="2"></line>
      <line x1="176" y1="213" x2="198" y2="213" stroke="var(--aw-color-primary)" stroke-width="2"></line>
      <line x1="176" y1="222" x2="198" y2="222" stroke="var(--aw-color-primary)" stroke-width="2"></line>
    </g>

    <!-- sidewalk slab -->
    <rect x="230" y="330" width="290" height="22" fill="var(--aw-color-bg-page)"></rect>
    <rect x="230" y="330" width="290" height="22" fill="var(--aw-color-primary)" opacity="0.1"></rect>
    <line x1="230" y1="330" x2="520" y2="330" stroke="var(--aw-color-primary)" stroke-width="2" opacity="0.45"></line>
    <line x1="330" y1="330" x2="330" y2="352" stroke="var(--aw-color-primary)" stroke-width="1.5" opacity="0.3"></line>
    <line x1="430" y1="330" x2="430" y2="352" stroke="var(--aw-color-primary)" stroke-width="1.5" opacity="0.3"></line>

    <!-- trench + buried conduit -->
    <rect x="196" y="392" width="304" height="30" rx="4" fill="url(#trench-hatch)"></rect>
    <rect
      x="196"
      y="392"
      width="304"
      height="30"
      rx="4"
      fill="none"
      stroke="var(--aw-color-primary)"
      stroke-width="1.6"
      stroke-dasharray="7 5"
      opacity="0.55"></rect>
    <path
      d="M187 238 187 407 H482 V330"
      fill="none"
      stroke="var(--aw-color-accent)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>

    <!-- curb -->
    <path d="M520 330 V352 H540" fill="none" stroke="var(--aw-color-primary)" stroke-width="2.4" opacity="0.55"></path>

    <!-- station -->
    <g>
      <rect x="470" y="222" width="26" height="112" rx="4" fill="var(--aw-color-primary)"></rect>
      <rect x="452" y="182" width="62" height="66" rx="8" fill="var(--aw-color-primary)"></rect>
      <rect x="462" y="194" width="42" height="24" rx="3" fill="var(--aw-color-bg-page)" opacity="0.92"></rect>
      <circle cx="474" cy="232" r="4.4" fill="var(--aw-color-accent)"></circle>
      <rect x="486" y="227" width="18" height="10" rx="2" fill="var(--aw-color-bg-page)" opacity="0.75"></rect>
      <!-- cable to car -->
      <path
        d="M514 214 C 560 214 566 268 604 268"
        fill="none"
        stroke="var(--aw-color-accent)"
        stroke-width="5"
        stroke-linecap="round"></path>
    </g>

    <!-- car -->
    <g>
      <path
        d="M596 300 606 262 C 610 250 620 244 632 244 H714 C 726 244 736 250 742 260 L760 290 H772 C 782 290 790 297 790 307 V318 C 790 324 785 328 779 328 H600 C 594 328 590 324 590 318 V310 C 590 304 592 301 596 300Z"
        fill="var(--aw-color-primary)"
        opacity="0.9"></path>
      <path d="M622 262 H700 L712 288 H612Z" fill="var(--aw-color-bg-page)" opacity="0.55"></path>
      <circle cx="638" cy="330" r="19" fill="var(--aw-color-primary)"></circle>
      <circle cx="638" cy="330" r="8" fill="var(--aw-color-bg-page)" opacity="0.8"></circle>
      <circle cx="744" cy="330" r="19" fill="var(--aw-color-primary)"></circle>
      <circle cx="744" cy="330" r="8" fill="var(--aw-color-bg-page)" opacity="0.8"></circle>
      <circle cx="604" cy="268" r="7" fill="var(--aw-color-accent)"></circle>
    </g>

    <!-- labels -->
    <g
      class="dg-labels"
      font-family="var(--aw-font-sans), system-ui, sans-serif"
      font-size="15"
      font-weight="600"
      fill="var(--aw-color-text-default)"
    >
      <line x1="207" y1="200" x2="272" y2="150" stroke="var(--aw-color-text-muted)" stroke-width="1.4"></line>
      <circle cx="207" cy="200" r="3" fill="var(--aw-color-text-muted)"></circle>
      <text x="278" y="146">Your panel</text>
      <text x="278" y="166" font-size="13" font-weight="400" fill="var(--aw-color-text-muted)">50A spare capacity</text>

      <line x1="348" y1="407" x2="348" y2="444" stroke="var(--aw-color-text-muted)" stroke-width="1.4"></line>
      <circle cx="348" cy="407" r="3" fill="var(--aw-color-text-muted)"></circle>
      <text x="358" y="449">Trench, conduit, circuit</text>

      <line x1="452" y1="196" x2="404" y2="118" stroke="var(--aw-color-text-muted)" stroke-width="1.4"></line>
      <circle cx="452" cy="196" r="3" fill="var(--aw-color-text-muted)"></circle>
      <text x="316" y="112">Your station</text>
      <text x="316" y="132" font-size="13" font-weight="400" fill="var(--aw-color-text-muted)">
        Level 2 &middot; you set the rate
      </text>

      <line x1="640" y1="252" x2="640" y2="196" stroke="var(--aw-color-text-muted)" stroke-width="1.4"></line>
      <circle cx="640" cy="252" r="3" fill="var(--aw-color-text-muted)"></circle>
      <text x="600" y="190">Driver taps a card</text>
      <text x="600" y="210" font-size="13" font-weight="400" fill="var(--aw-color-text-muted)">
        You keep it, minus our fee
      </text>
    </g>
  </svg>

  <!-- Below 640px the in-SVG labels shrink to ~6px, so they are hidden and the
       same four callouts are rendered as real text instead. -->
  <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-left sm:hidden">
    <div>
      <dt class="text-sm font-semibold">Your panel</dt>
      <dd class="text-sm text-muted">50A spare capacity</dd>
    </div>
    <div>
      <dt class="text-sm font-semibold">The run</dt>
      <dd class="text-sm text-muted">Trench, conduit, circuit</dd>
    </div>
    <div>
      <dt class="text-sm font-semibold">Your station</dt>
      <dd class="text-sm text-muted">Level 2 &middot; you set the rate</dd>
    </div>
    <div>
      <dt class="text-sm font-semibold">Driver taps a card</dt>
      <dd class="text-sm text-muted">You keep it, minus our fee</dd>
    </div>
  </dl>
</div>

<style>
  .dg-labels {
    display: none;
  }

  @media (min-width: 640px) {
    .dg-labels {
      display: inline;
    }
  }
</style>
